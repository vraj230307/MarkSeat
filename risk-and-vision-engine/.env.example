# Gemini API Credentials
GEMINI_API_KEY=your_gemini_api_key_here

# Real-Time Risk Engine Thresholds (Rule-Based Filter)
MAX_ACTIONS_PER_MIN=60
MIN_CLICK_INTERVAL_MS=100
MAX_SEATS_SELECTED_BURST=10
MAX_SEAT_CHANGES_WINDOW=5
MAX_FAILED_ATTEMPTS=5
MIN_SESSION_DURATION_MS=2000
REPEATED_ACTION_THRESHOLD=3

# Challenge Verification Configuration
CHALLENGE_EXPIRY_SECONDS=60

# External Integration Services
TICKET_SERVICE_REVOKE_URL=http://localhost:3000/tickets/revoke # Must point to the real crypto-service's /tickets/revoke endpoint. This service does NOT implement ticket revocation itself.

# Server & Simulator Configuration
PORT=3001
TARGET_BOOKING_URL=http://localhost:3001/demo-booking

# Rate Limiting Configuration (Configurable Thresholds)
# Tier 1: Authentication Routes (Stricter + Exponential Backoff)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_MAX_REQUESTS_PER_WINDOW=5
AUTH_BASE_BACKOFF_MS=2000
AUTH_BACKOFF_FACTOR=2
AUTH_MAX_BACKOFF_MS=300000

# Tier 2: Public Endpoints (Moderate Limits)
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_MAX_REQUESTS_PER_WINDOW=60

# Tier 3: Authenticated Endpoints (Looser Limits)
AUTHED_RATE_LIMIT_WINDOW_MS=60000
AUTHED_MAX_REQUESTS_PER_WINDOW=200
